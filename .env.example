# Copy this file to .env and replace every change_me value.
# Runtime profile. Local development uses localhost; production must use HTTPS.
APP_ENV=development
TERMS_APPROVED=true

# Public application intake is available for local testing.
# For production, set PUBLIC_SITE_ORIGIN to the real HTTPS domain and keep
# at least one monitored privacy contact configured.

# ---- PostgreSQL superuser ----
POSTGRES_USER=chekad
POSTGRES_PASSWORD=change_me_postgres_superuser
POSTGRES_DB=postgres

# ---- Auth database ----
AUTH_DB_NAME=chekad_auth
AUTH_DB_MIGRATOR=chekad_auth_migrator
AUTH_DB_MIGRATOR_PASSWORD=change_me_auth_migrator
AUTH_DB_USER=chekad_auth_app
AUTH_DB_PASSWORD=change_me_auth_runtime

# ---- Application database ----
APP_DB_NAME=chekad_application
APP_DB_MIGRATOR=chekad_application_migrator
APP_DB_MIGRATOR_PASSWORD=change_me_application_migrator
APP_DB_USER=chekad_application_app
APP_DB_PASSWORD=change_me_application_runtime

# ---- People database ----
PEOPLE_DB_NAME=chekad_people
PEOPLE_DB_MIGRATOR=chekad_people_migrator
PEOPLE_DB_MIGRATOR_PASSWORD=change_me_people_migrator
PEOPLE_DB_USER=chekad_people_app
PEOPLE_DB_PASSWORD=change_me_people_runtime

# ---- Content database ----
CONTENT_DB_NAME=chekad_content
CONTENT_DB_MIGRATOR=chekad_content_migrator
CONTENT_DB_MIGRATOR_PASSWORD=change_me_content_migrator
CONTENT_DB_USER=chekad_content_app
CONTENT_DB_PASSWORD=change_me_content_runtime

# ---- Gateway ----
GATEWAY_PORT=8080

# ---- Admin authentication ----
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars
JWT_EXPIRE_MINUTES=120
JWT_ISSUER=chekad-auth
JWT_AUDIENCE=chekad-admin
AUTH_COOKIE_SECURE=false

# ---- Student accounts ----
# Enable only after reviewing the student privacy/guardian-consent process.
STUDENT_REGISTRATION_ENABLED=false

# ---- First administrator bootstrap ----
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=مدیر چکاد

# ---- Public application intake and privacy ----
PUBLIC_APPLICATIONS_ENABLED=true
PUBLIC_SITE_ORIGIN=http://localhost:8080
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTACT_PHONE=09918891553
PRIVACY_CONTACT_TELEGRAM=alirf11
PURGE_APPLICATIONS_AFTER_DAYS=365

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=/api
